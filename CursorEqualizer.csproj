<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);.local/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="CursorEqualizer.AppIcon" />
    <EmbeddedResource Include="Assets\AppLogo.png" LogicalName="CursorEqualizer.AppLogo" />
    <EmbeddedResource Include="Assets\DonationQrPh.png" LogicalName="CursorEqualizer.DonationQrPh" />
  </ItemGroup>
</Project>
